# Optional frontend settings. Copy to .env to use. Vite only exposes VITE_ variables.

# Backend URL (no trailing slash). Leave unset to use the defaults:
#   npm run dev    -> http://localhost:8000
#   npm run build  -> the same site the app is served from (production)
# VITE_API_BASE_URL=http://localhost:8000

# Request timeout in milliseconds for all API calls.
VITE_API_TIMEOUT=15000
